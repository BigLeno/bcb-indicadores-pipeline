# Copie para .env (ou rode `make env`, que já gera os segredos).
# Nunca versione o .env.

# UID do seu usuário no host (`id -u`), para os arquivos em logs/ não ficarem com dono root.
AIRFLOW_UID=50000

# Portas expostas no host
AIRFLOW_HOST_PORT=8080
WAREHOUSE_HOST_PORT=5433

# Usuário admin da UI do Airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me

# Segredos internos do Airflow
# Fernet: 32 bytes em base64 url-safe, usada para cifrar as connections no metadata DB.
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_API_SECRET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me

# Metadata DB do Airflow
AIRFLOW_DB_PASSWORD=change-me

# Postgres do pipeline (warehouse)
WAREHOUSE_DB=bcb
WAREHOUSE_USER=bcb
WAREHOUSE_PASSWORD=change-me
